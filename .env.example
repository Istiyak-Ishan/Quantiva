# Copy only if .env does not already exist; never overwrite existing credentials.
GOOGLE_API_KEY=replace-with-your-google-api-key
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
METRICS_TOKEN=replace-with-an-independent-random-secret
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
QDRANT_COLLECTION=quantiva_v2
CORS_ORIGINS=["http://localhost:3000"]
S3_PUBLIC_ENDPOINT_URL=http://localhost:9090
# Optional external ClamAV scanner. Leave empty to disable malware scanning.
CLAMAV_HOST=
CLAMAV_PORT=3310
