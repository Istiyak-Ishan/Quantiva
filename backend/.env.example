# Database
DATABASE_URL=postgresql+asyncpg://quantiva_user:quantiva_password@localhost:5432/quantiva_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_URL=http://localhost:6333

# S3 / LocalStack
S3_ENDPOINT_URL=http://localhost:9090
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# App Secrets
GOOGLE_API_KEY=your-dev-google-api-key
SECRET_KEY=your-dev-secret-key-change-in-prod
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000"]
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
QDRANT_COLLECTION=quantiva_v2
S3_PUBLIC_ENDPOINT_URL=http://localhost:9090
MAX_UPLOAD_BYTES=26214400
# OCR fallback for scanned PDFs. Tesseract is checked in bundled vendor
# directories first, then on PATH. Missing OCR only adds warning metadata.
OCR_ENABLED=true
# OCR_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANGUAGES=eng
OCR_DPI=200
OCR_MIN_TEXT_CHARS=30
PII_ENGINE=patterns
# Optional: set PII_ENGINE=presidio after provisioning this model explicitly.
SPACY_MODEL=en_core_web_sm
# Optional ClamAV INSTREAM scanner. Uploads fail closed when a host is set.
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310
# /metrics is disabled when unset. Use a different secret from SECRET_KEY.
METRICS_TOKEN=
# Optional pricing: set current rates for the selected model to enable cost estimates.
# LLM_INPUT_USD_PER_MILLION=
# LLM_OUTPUT_USD_PER_MILLION=
