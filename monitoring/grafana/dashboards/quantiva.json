      "targets": [{
        "datasource": { "type": "prometheus" },
        "expr": "active_streaming_sessions",
        "legendFormat": "Active SSE Streams",
        "refId": "A"
      }],
      "title": "Active Streaming Sessions",
      "type": "stat"
