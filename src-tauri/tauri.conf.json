{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quantiva",
  "version": "0.1.0",
  "identifier": "com.quantiva.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../frontend/out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Quantiva — Private AI Document Intelligence",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "single-instance": {},
    "shell": {},
    "dialog": {},
    "fs": {}
  }
}
